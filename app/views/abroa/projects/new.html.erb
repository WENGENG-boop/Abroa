<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<div class="max-w-lg mx-auto space-y-4">
  <%= render DS::Link.new(text: t("abroa.projects.title"), variant: "ghost", icon: "arrow-left", href: abroa_projects_path) %>
  <h1 class="text-2xl font-medium"><%= t("abroa.projects.new") %></h1>
  <%= render DS::Card.new do %>
    <%= styled_form_with model: @project, scope: :project, url: abroa_projects_path, class: "space-y-4" do |form| %>
      <%= hidden_field_tag :idempotency_key, @idempotency_key %>
      <%= form.text_field :name, label: t("abroa.projects.name"), required: true %>
      <%= form.text_field :country, label: t("abroa.projects.country"), maxlength: 2, required: true %>
      <%= form.text_field :school, label: t("abroa.projects.school") %>
      <%= form.text_field :city, label: t("abroa.projects.city") %>
      <%= form.date_field :start_on, label: t("abroa.projects.start_on"), required: true %>
      <%= form.date_field :end_on, label: t("abroa.projects.end_on") %>
      <%= form.text_field :currency, label: t("abroa.projects.currency"), maxlength: 3, required: true %>
      <%= form.text_field :timezone, label: t("abroa.projects.timezone"), required: true %>
      <%= form.submit t("abroa.projects.create") %>
    <% end %>
  <% end %>
</div>
