# Copy this example to a private, chmod-600 file outside version control.
# NEVER deploy with placeholder values or regenerate an existing secret.
# Docker Compose reads the .env next to your deployment compose files.
COMPOSE_PROJECT_NAME=abroa
ABROA_IMAGE=abroa:p5
ABROA_HTTP_PORT=3300
ABROA_DB_NAME=abroa
ABROA_DB_USER=abroa
ABROA_DB_PASSWORD=
ABROA_REDIS_PASSWORD=
ABROA_SECRET_KEY_BASE=
ABROA_FORCE_SSL=false
ABROA_ASSUME_SSL=false
ABROA_AUTO_SYNC_ENABLED=true
# Set all three encryption fields only for a NEW installation, or copy
# the exact previous values when upgrading. Partial replacement is unsafe.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# No payment processor, plan prices, free quotas, or cloud AI keys are assumed.
